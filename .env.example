YOUCAM_API_KEY=replace-with-your-youcam-api-key
DEMO_ACCESS_CODE=replace-with-the-judge-access-code
SESSION_SECRET=replace-with-at-least-32-random-characters

# Public, rights-cleared reference images. YouCam fetches these server-side.
GARMENT_SILVER_URL=https://example.com/silver-headliner.jpg
GARMENT_CRIMSON_URL=https://example.com/crimson-entrance.jpg
GARMENT_MIDNIGHT_URL=https://example.com/midnight-icon.jpg

DATA_DIR=./data
DAILY_SESSION_LIMIT=10
MAX_VTO_CONCURRENCY=2
YOUCAM_POLL_INTERVAL_MS=3000
